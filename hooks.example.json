{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/ABSOLUTE/PATH/TO/YOUR/PROJECT/tools/context-warning.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/ABSOLUTE/PATH/TO/YOUR/PROJECT/tools/context-warning.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/ABSOLUTE/PATH/TO/YOUR/PROJECT/tools/context-warning.py\"",
            "timeout": 5,
            "additionalContextLimit": 600
          }
        ],
        "matcher": "compact"
      }
    ]
  }
}
